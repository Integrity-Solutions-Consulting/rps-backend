POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# El backend (.NET) no lee este archivo .env directamente — solo lo usa docker-compose.yml para
# el contenedor de Postgres. Las variables de abajo son solo documentación de lo que hay que
# exportar en la terminal (o configurar en Dokploy) antes de correr el backend o el bootstrap.

# Firma de los JWT. Mínimo 32 caracteres. En local va directo en appsettings.Development.json
# (gitignored); en Dokploy se configura como variable de entorno del servicio.
Jwt__SecretKey=

# Conexión con TMR. En local van en appsettings.Development.json; en Dokploy como variables de
# entorno. Tmr__ApiKey debe ser igual a IntegracionRps__ApiKey configurada en tmr-backend.
Tmr__BaseUrl=
Tmr__ApiKey=
# Sincronización automática: apagada si no se define. Intervalo por defecto: 30 minutos.
Tmr__Sincronizacion__Habilitada=
Tmr__Sincronizacion__IntervaloMinutos=

# Solo se usan una vez, al correr "dotnet run -- --initialize-data" contra una base sin usuarios
# todavía (crea el primer usuario, rol Administrador). Las tres juntas o ninguna.
Bootstrap__AdminEmail=
Bootstrap__AdminPassword=
Bootstrap__AdminNombre=